/-!
# Differential tests of the probability notation

Generated by `scripts/gen-notation-differential.py`; do not edit. Each case states one exact value
twice: for the notation `Pr{items}[t]`, which translates the sequence itself, and for the
reference `Pr{let r ← (do items; return (t : Prop))}[r]`, which Lean's own `do` elaborates. The
value is computed by the generator, which runs the sequence on every outcome of its coins.
-/

public section

open OracleComp
open scoped ENNReal

namespace VCVioTest.NotationDifferential

-- The generated sequences bind more than their events read, on lines of any length.
set_option linter.unusedVariables false
set_option linter.style.longLine false

/-- Evaluate a finite coin model: `simp` reduces it to numeral arithmetic in `ℝ≥0∞`, which is
checked in `ℝ`. (`basify`, the recipe of `VCVioTest/ENNRealNumerals.lean`, misses some of the
shapes `simp` leaves here.) -/
local macro "ennreal_value" : tactic => `(tactic| (
  simp [Finset.filter_insert, Finset.filter_singleton]
  try (
    rw [← ENNReal.toReal_eq_toReal_iff' (by simp [ENNReal.div_eq_top, ENNReal.mul_eq_top])
      (by simp [ENNReal.div_eq_top, ENNReal.mul_eq_top])]
    simp (disch := simp [ENNReal.div_eq_top, ENNReal.mul_eq_top])
      [ENNReal.toReal_div, ENNReal.toReal_add, ENNReal.toReal_inv, ENNReal.toReal_mul]
    all_goals norm_num)))

